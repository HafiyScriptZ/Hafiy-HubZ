local function clearESP()
    for _, hl in pairs(espHighlights) do pcall(function() hl:Destroy() end) end
    espHighlights = {}
    for plr, c in pairs(espConnections) do
        if type(plr) == WvfKLNGvlRTslstBTznBLovPoc('') and plr:IsA(WvfKLNGvlRTslstBTznBLovPoc('')) then
            pcall(function() c:Disconnect() end)
        end
    end
    espConnections = {}
end

local function addESP(plr)
    if plr == lp or not plr.Character or espHighlights[plr] then return end
    local char = plr.Character
    local hl = Instance.new(WvfKLNGvlRTslstBTznBLovPoc(''))
    hl.Name = WvfKLNGvlRTslstBTznBLovPoc('')
    hl.FillColor = Color3.fromRGB(255, 60, 80)
    hl.OutlineColor = Color3.new(1, 1, 1)
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = char
    espHighlights[plr] = hl
end

local function removeESP(plr)
    if espHighlights[plr] then
        pcall(function() espHighlights[plr]:Destroy() end)
        espHighlights[plr] = nil
    end
    if espConnections[plr] then
        pcall(function() espConnections[plr]:Disconnect() end)
        espConnections[plr] = nil
    end
end

local function setESP(enabled)
    if not enabled then clearESP() return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp then
            addESP(plr)
            if not espConnections[plr] then
                espConnections[plr] = plr.CharacterAdded:Connect(function()
                    task.wait(0.3)
                    if espEnabled then addESP(plr) end
                end)
            end
        end
    end
    if not espConnections.PlayerAdded then
        espConnections.PlayerAdded = Players.PlayerAdded:Connect(function(plr)
            if plr == lp then return end
            espConnections[plr] = plr.CharacterAdded:Connect(function()
                task.wait(0.3)
                if espEnabled then addESP(plr) end
            end)
        end)
    end
    if not espConnections.PlayerRemoving then
        espConnections.PlayerRemoving = Players.PlayerRemoving:Connect(function(plr)
            removeESP(plr)
        end)
    end
end

